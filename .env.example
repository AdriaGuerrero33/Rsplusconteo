# Ruta al archivo JSON de credenciales del Service Account de Google
GOOGLE_CREDENTIALS_PATH=credentials.json

# URL o ID de la hoja de Google Sheets
# Ejemplo URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
# Ejemplo ID: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
SHEET_URL=

# Nombre de la pestaña donde están las reseñas (dejar vacío para usar la primera)
SOURCE_SHEET_TAB=

# Nombre de la pestaña donde se escribirán los resultados
RESULTS_TAB=Estado_Reseñas

# Número máximo de verificaciones en paralelo (recomendado: 3-5)
MAX_CONCURRENT_CHECKS=3

# Segundos de espera entre peticiones para evitar bloqueos
DELAY_BETWEEN_CHECKS=2
